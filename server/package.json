{
  "name": "@chore-helper/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:db": "npm run test:db:reset && vitest run test/prismaStore.test.ts",
    "test:db:reset": "tsx test/verifyTestDatabase.ts && prisma db push --force-reset --accept-data-loss",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@chore-helper/shared": "0.0.0",
    "@clerk/express": "^2.1.21",
    "@openai/agents": "^0.11.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "pg": "^8.21.0",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^2.1.8"
  }
}
