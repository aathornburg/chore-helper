generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Household {
  id              String             @id
  name            String
  timeZone        String             @default("America/New_York")
  profile         HouseholdProfile?
  floors          HouseholdFloor[]
  chores          Chore[]
  recommendations Recommendation[]
  members         HouseholdMember[]
  invitations     HouseholdInvitation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model User {
  id              String                @id @default(cuid())
  clerkUserId     String                @unique
  primaryEmail    String?               @unique
  displayName     String?
  memberships     HouseholdMember[]
  sentInvitations HouseholdInvitation[] @relation("InvitationInviter")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([householdId, userId])
}

model HouseholdProfile {
  householdId     String    @id
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  homeType        String
  hasPets         Boolean
  hasOutdoorSpace Boolean
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model HouseholdInvitation {
  id               String    @id @default(cuid())
  householdId      String
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipientEmail   String
  role             String    @default("member")
  tokenDigest      String    @unique
  invitedByUserId  String
  invitedBy        User      @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([householdId, recipientEmail])
}

model HouseholdFloor {
  dbId                String          @id @default(cuid())
  id                  String
  householdId         String
  household           Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name                String
  levelType           String
  flooring            String
  petImpact           String
  robotVacuumCoverage String
  robotMopCoverage    String
  notes               String?
  sortOrder           Int
  rooms               HouseholdRoom[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([householdId, id])
}

model HouseholdRoom {
  dbId                String         @id @default(cuid())
  id                  String
  floorDbId           String
  floor               HouseholdFloor @relation(fields: [floorDbId], references: [dbId], onDelete: Cascade)
  name                String
  flooring            String
  petImpact           String
  robotVacuumCoverage String
  robotMopCoverage    String
  notes               String?
  sortOrder           Int
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([floorDbId, id])
}

model Chore {
  id               String    @id
  householdId      String
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title            String
  cadence          String
  estimatedMinutes Int
  source           String
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Recommendation {
  id                       String    @id
  householdId              String
  household                Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  affectedChoreId          String?
  title                    String
  rationale                String
  confidence               String
  status                   String
  decision                 String    @default("pending")
  proposedCadence          String?
  proposedEstimatedMinutes Int?
  staleAt                  DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}
